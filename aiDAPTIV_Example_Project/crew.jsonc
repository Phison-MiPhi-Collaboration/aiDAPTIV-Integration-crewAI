{
  "name": "testing",
  "agents": ["developer"],

  
  "tasks": [
    {
      "name": "explainer",
      "description": "Document:\n{doc}\n\nQuestion: {question}",
      "expected_output": "A short, simple and accurate answer to the question: {question}",
      "agent": "developer"
    }
  ],

  "chat_llm": { 
    "model": "gemma-4", 
    "provider": "openai", 
    "base_url": "http://localhost:8080/v1", 
    "api_key": "not-needed" 
    //, "extra_body": { 
    //   "cache_prompt": true, 
    //   "offload_folder_name": "Testing" 
    } ,

  "process": "sequential",
  "verbose": true,
  "memory": false,
